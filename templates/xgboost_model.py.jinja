{% extends "base_experiment.py.jinja" %}

{% block imports %}
import xgboost as xgb
{% endblock %}

{% block model %}
    {% if task_type == 'regression' %}
    return xgb.XGBRegressor({{ model_params_str }}random_state=RANDOM_STATE, n_jobs=-1, verbosity=0)
    {% elif task_type == 'classification' %}
    return xgb.XGBClassifier({{ model_params_str }}random_state=RANDOM_STATE, n_jobs=-1, verbosity=0, eval_metric='logloss')
    {% else %}
    # Default to XGBRegressor
    return xgb.XGBRegressor(n_estimators=100, random_state=RANDOM_STATE, n_jobs=-1, verbosity=0)
    {% endif %}
{% endblock %}
